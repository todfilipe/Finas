# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI (parsing por IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Base de dados
# Local: o host é localhost. Na VPS com docker-compose.prod.yml o host é db.
DATABASE_URL=postgresql+psycopg://finas:finas@localhost:5432/finas

# Password do Postgres, usada pelo docker-compose.prod.yml
POSTGRES_PASSWORD=finas

# Configuração geral
DEFAULT_TIMEZONE=Europe/Lisbon
DEFAULT_CURRENCY=EUR

# API (origens permitidas pela dashboard, separadas por virgula)
# Em produção a dashboard fala com a API por dentro da rede do Docker, o browser
# nunca chama a API diretamente, por isso isto so importa em desenvolvimento.
CORS_ORIGINS=http://localhost:3000

# Dashboard (usado no link de acesso que o bot envia)
# Em produção: https://dashboard.finas.online
DASHBOARD_URL=http://localhost:3000

# Sessao da dashboard (mudar SESSION_SECRET em producao, COOKIE_SECURE=true com HTTPS)
SESSION_SECRET=muda-isto
SESSION_DAYS=30
COOKIE_SECURE=false
LOGIN_CODE_MINUTES=5
MAX_LOGIN_ATTEMPTS=5
