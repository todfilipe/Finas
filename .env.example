# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI (parsing por IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Base de dados
# Local: o host é localhost. Na VPS com docker-compose.prod.yml o host é db.
DATABASE_URL=postgresql+psycopg://finas:finas@localhost:5432/finas

# Password do Postgres, usada pelo docker-compose.prod.yml
POSTGRES_PASSWORD=finas

# Configuração geral
DEFAULT_TIMEZONE=Europe/Lisbon
DEFAULT_CURRENCY=EUR

# API (origens permitidas pela dashboard, separadas por virgula)
# Em produção a dashboard fala com a API por dentro da rede do Docker, o browser
# nunca chama a API diretamente, por isso isto so importa em desenvolvimento.
CORS_ORIGINS=http://localhost:3000

# Dashboard (usado no link de acesso que o bot envia)
# Em produção: https://dashboard.finas.online
DASHBOARD_URL=http://localhost:3000

# Sessao da dashboard (mudar SESSION_SECRET em producao, COOKIE_SECURE=true com HTTPS)
SESSION_SECRET=muda-isto
SESSION_DAYS=30
COOKIE_SECURE=false
LOGIN_CODE_MINUTES=5
MAX_LOGIN_ATTEMPTS=5

# Logging (DEBUG, INFO, WARNING ou ERROR)
LOG_LEVEL=INFO

# Alertas de erro por Telegram
# O teu id de utilizador do Telegram (nao o do bot). Deixa vazio para desligar os alertas.
# Para o descobrires, fala com o @userinfobot no Telegram.
ADMIN_TELEGRAM_ID=

# Minutos de espera antes de repetir um alerta igual, para nao encher o chat
ALERT_MINUTES=5

# Quem pode usar o bot (ids de utilizador do Telegram, separados por virgula)
# Vazio: qualquer pessoa que encontre o bot pode usa-lo e gastar chamadas a IA.
# Recomendado: poe aqui o teu id (o mesmo do ADMIN_TELEGRAM_ID) para o bot ficar so teu.
ALLOWED_TELEGRAM_IDS=

# Rate limiting do bot (mensagens por utilizador dentro da janela)
BOT_MAX_MESSAGES=20
BOT_RATE_WINDOW_SECONDS=60

# Rate limiting da API (pedidos por utilizador com sessao, dentro da janela)
API_MAX_REQUESTS=120
API_RATE_WINDOW_SECONDS=60

# Segundos a esperar por uma ligacao a base de dados antes de desistir
DB_CONNECT_SECONDS=5
